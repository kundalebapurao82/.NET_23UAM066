@model List<StudentEFApp.Models.Student>

<h2>Student List</h2>

<table class="table">
    <tr>
        <th>Name</th>
        <th>Age</th>
        <th>Email</th>
        <th>Action</th>
    </tr>

    @foreach (var s in Model)
    {
        <tr>
            <td>@s.Name</td>
            <td>@s.Age</td>
            <td>@s.Email</td>
            <td>
                <a href="/Student/Edit/@s.Id" class="btn btn-warning">Edit</a>
                <a href="/Student/Delete/@s.Id" class="btn btn-danger">Delete</a>
            </td>
        </tr>
    }
</table>