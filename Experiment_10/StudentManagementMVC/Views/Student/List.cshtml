@model List<StudentManagementMVC.Models.Student>

<h2>Student List</h2>

<a href="/Student/Add">Add New Student</a>

<table border="1" cellpadding="10">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Department</th>
        <th>Marks</th>
    </tr>

@foreach (var s in Model)
{
    <tr>
        <td>@s.Id</td>
        <td>@s.Name</td>
        <td>@s.Department</td>
        <td>@s.Marks</td>
    </tr>
}
</table>